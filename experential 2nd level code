import os

# Secret key
key = 5

# Create a sample file
with open("document.txt", "w") as f:
    f.write("Hello Mehzabin! This is my secret file.")

# Encryption
def encrypt(text):
    return "".join(chr(ord(ch) + key) for ch in text)

# Decryption
def decrypt(text):
    return "".join(chr(ord(ch) - key) for ch in text)

# Read original file
with open("document.txt", "r") as f:
    original = f.read()

print("===== FILE ENCRYPTION TOOL =====")
print("Original File:", original)

# Encrypt file
encrypted = encrypt(original)
with open("encrypted.txt", "w") as f:
    f.write(encrypted)

print("\nFile Encrypted Successfully!")
print("Encrypted Data:", encrypted)

# Decrypt file
with open("encrypted.txt", "r") as f:
    encrypted_data = f.read()

decrypted = decrypt(encrypted_data)
with open("decrypted.txt", "w") as f:
    f.write(decrypted)

print("\nFile Decrypted Successfully!")
print("Decrypted Data:", decrypted)

print("\nPROJECT EXECUTED SUCCESSFULLY!")
